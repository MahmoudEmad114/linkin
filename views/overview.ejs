<!DOCTYPE html>

<html>
  <head>
    <title>LINKIN | Your Links, One Place</title>

    <link rel="icon" type="image/png" href="/images/favicon.png" />

    <link rel="stylesheet" href="/css/style.css" />

    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <main class="overview">
      <section class="overview-hero">
        <div class="overview-logo">LINK<span>IN</span></div>

        <h1>
          Your Links.
          <span>One Place.</span>
        </h1>

        <p class="overview-description">
          Save, organize and manage all your important links in one simple and
          beautiful place.
        </p>

        <div class="overview-actions">
          <a href="/login" class="overview-btn primary"> Login </a>

          <a href="/register" class="overview-btn secondary"> Sign Up </a>
        </div>

        <div class="overview-features">
          <div class="feature">
            <div class="feature-icon">🔗</div>

            <h3>Save Links</h3>

            <p>
              Keep your favorite and important links organized in one place.
            </p>
          </div>

          <div class="feature">
            <div class="feature-icon">⚡</div>

            <h3>Fast &amp; Simple</h3>

            <p>Access your links quickly without unnecessary complexity.</p>
          </div>

          <div class="feature">
            <div class="feature-icon">🔒</div>

            <h3>Private</h3>

            <p>Your saved links are connected to your personal account.</p>
          </div>
        </div>
      </section>
    </main>

    <%- include('_footer') %>
  </body>
</html>
